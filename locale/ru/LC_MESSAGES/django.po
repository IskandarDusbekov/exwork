msgid ""
"\n"
"Нега:"
msgstr ""
"\n"
"Почему:"

#: jobs/templates/jobs/batch.html:450
msgid "та жуфтлик"
msgstr "пар"

#: jobs/templates/jobs/batch.html:450
msgid "қўлда танландингиз"
msgstr "выбрано вами вручную"

#: jobs/templates/jobs/batch.html:450 jobs/templates/jobs/project.html:294
msgid "\">мослик"
msgstr "\">совпадение"

#: jobs/templates/jobs/batch.html:450
