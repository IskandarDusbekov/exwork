msgid "Папкада ва архивларда Excel файл топилмади (фақат .xls, .xlsx, .xlsm)"
msgstr "В папке и архивах не найден файл Excel (только .xls, .xlsx, .xlsm)"

#: jobs/folders.py:124
msgid "жуда катта ({0} МБ)"
msgstr "слишком большой ({0} МБ)"

#: jobs/folders.py:134
msgid "сақлаб бўлмади: {0}"
msgstr "не удалось сохранить: {0}"

#: jobs/folders.py:140
