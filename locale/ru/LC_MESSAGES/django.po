#: jobs/folders.py:72
msgid "Нотўғри файл йўли: {0!r}"
msgstr "Неверный путь к файлу: {0!r}"

#: jobs/folders.py:81
msgid "Папкада Excel файл топилмади"
msgstr "В папке не найден файл Excel"

