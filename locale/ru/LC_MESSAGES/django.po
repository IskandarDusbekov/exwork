msgstr "Не удалось открыть лист"

#: texnazor/views_acts.py:454
msgid "Қаторлар нотўғри"
msgstr "Неверные строки"

#: texnazor/views_my.py:41
msgid "«{0}» — фоиз сон бўлиши керак"
msgstr "«{0}» — процент должен быть числом"

#: texnazor/views_my.py:43
