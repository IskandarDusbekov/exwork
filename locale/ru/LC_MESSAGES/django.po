msgstr "Статус"

#: jobs/templates/jobs/job.html:1678
msgid "Таклиф"
msgstr "Предложение"

#: jobs/templates/jobs/job.html:1683
msgid "ресурсда: {0}"
msgstr "в ресурсе: {0}"

#: jobs/templates/jobs/job.html:1693
msgid "Ҳамма қаторларда нарх рақам"
msgstr "Во всех строках цена — число"

#: jobs/templates/jobs/job.html:1746
msgid "Танланган қаторлар билан амаллар"
msgstr "Действия с выбранными строками"

#: jobs/templates/jobs/job.html:1746
msgid "Белгиланган қаторлар. Қаторни қайта боссангиз — белги олинади"
msgstr "Отмеченные строки. Повторный щелчок по строке снимает отметку"

#: jobs/templates/jobs/job.html:1750
msgid "Жадвалда фақат белгиланган қаторларни кўрсатиш"
msgstr "Показать в таблице только отмеченные строки"

#: jobs/templates/jobs/job.html:1750
msgid "фақат шулар"
msgstr "только эти"

#: jobs/templates/jobs/job.html:1750
msgid ""
"Сумма қайси устунга тушсин? Иш ҳақи, машина, материал (I, J, K) ўзи тақсимланади"
msgstr ""
"В какой столбец попадёт сумма? Зарплата, машины, материалы (I, J, K) распределяются сами"

#: jobs/templates/jobs/job.html:1750
msgid "Устун:"
msgstr "Столбец:"

#: jobs/templates/jobs/job.html:1755
msgid "{0} · {1} устунига ўтказиш"
msgstr "Перенести в столбец {0} · {1}"

#: jobs/templates/jobs/job.html:1756
msgid "Дастур аниқлаган устунга қайтариш"
msgstr "Вернуть в столбец, определённый программой"

#: jobs/templates/jobs/job.html:1757
msgid "асл"
msgstr "исходный"

#: jobs/templates/jobs/job.html:1757
msgid "Битта нарх — белгиланган ҳамма қаторларга (Enter — қўйиш, Esc — ёпиш)"
msgstr "Одна цена — всем отмеченным строкам (Enter — поставить, Esc — закрыть)"

#: jobs/templates/jobs/job.html:1757
msgid "Enter — қўйиш, Esc — ёпиш"
msgstr "Enter — поставить, Esc — закрыть"

#: jobs/templates/jobs/job.html:1757
msgid "Тизим топган энг яқин нархни қўйиш"
msgstr "Поставить ближайшую цену, найденную системой"

#: jobs/templates/jobs/job.html:1763
msgid "Қўлда қўйилган нархни олиб ташлаш"
msgstr "Убрать цену, поставленную вручную"

#: jobs/templates/jobs/job.html:1763
msgid "× нарх"
msgstr "× отменить цену"

#: jobs/templates/jobs/job.html:1763
msgid "Ёпиш — белгилар олинади (Esc)"
msgstr "Закрыть — отметки снимаются (Esc)"

#: jobs/templates/jobs/job.html:1803
msgid "· очиш →"
msgstr "· открыть →"

#: jobs/templates/jobs/job.html:1982
msgid "· юкланмоқда"
msgstr "· загружается"

#: jobs/templates/jobs/job.html:1982
msgid "· юкланмади:"
msgstr "· не загружено:"

#: jobs/templates/jobs/job.html:1982
msgid "— саҳифани янгиланг"
msgstr "— обновите страницу"

#: jobs/templates/jobs/job.html:2174
msgid "ф"
msgstr "ф"

#: jobs/templates/jobs/job.html:2174
msgid "Ф"
msgstr "Ф"

#: jobs/templates/jobs/job.html:2174
msgid "фақат танланганлар"
msgstr "только выбранные"

#: jobs/templates/jobs/job.html:2324
msgid "Устунлар ўзгартирилмоқда"
msgstr "Столбцы изменяются"

#: jobs/templates/jobs/job.html:2324
msgid "Кейин қаторларни белгилаб, пастки панелдан шу устунга ўтказасиз."
msgstr "Затем отметьте строки и перенесите их в этот столбец на нижней панели."

#: jobs/templates/jobs/job.html:2324
msgid "Янги устун"
msgstr "Новый столбец"

#: jobs/templates/jobs/job.html:2324 texnazor/templates/texnazor/object.html:96
msgid "Қўшиш"
msgstr "Добавить"

#: jobs/templates/jobs/job.html:2324
msgid "масалан «Монтаж ишлари»"
msgstr "например «Монтажные работы»"

#: jobs/templates/jobs/job.html:2324
msgid "» устун номи"
msgstr "» — название столбца"

#: jobs/templates/jobs/job.html:2324
msgid "Ундаги қаторлар асл устунига қайтади."
msgstr "Строки из него вернутся в исходный столбец."

#: jobs/templates/jobs/job.html:2324
msgid ") устуни ўчирилсинми?"
msgstr ") — удалить столбец?"

#: jobs/templates/jobs/job.html:2324
msgid "та қаторда нарх таклифи йўқ — улар ўзгармади."
msgstr "строк без предложения цены — они не изменились."

#: jobs/templates/jobs/job.html:2324
msgid "Баъзи қаторлар ўзгармади"
msgstr "Некоторые строки не изменились"

#: jobs/templates/jobs/job.html:2324
msgid "Нархни ёзинг"
msgstr "Введите цену"

#: jobs/templates/jobs/job.html:2324
msgid "жадвал юкланмоқда…"
msgstr "таблица загружается…"

#: jobs/templates/jobs/job.html:2324
msgid ""
"та қаторда нарх RES'дан аниқ топилган эди. Улар ҳам сиз ёзган нарх билан алмаштирилади."
msgstr ""
"строк имели цену, точно найденную в RES. Они тоже будут заменены введённой вами ценой."

#: jobs/templates/jobs/job.html:2324
msgid "Устидан ёзилсинми?"
msgstr "Перезаписать?"

#: jobs/templates/jobs/job.html:2324
msgid "Ҳа, алмаштириш"
msgstr "Да, заменить"

#: jobs/templates/jobs/job.html:2324
msgid "Кабель / ускунага ўтказилмоқда"
msgstr "Перенос в кабель / оборудование"

#: jobs/templates/jobs/job.html:2324
msgid "устунига ўтади. Сумма ва сводка қайта ҳисобланади."
msgstr "— будет перенесено в столбец. Сумма и сводка пересчитаются."

#: jobs/templates/jobs/job.html:2324
msgid "Ҳа, ажратиш"
msgstr "Да, разделить"

#: jobs/templates/jobs/job.html:2324
msgid "устунига ўтказилади. Сумма ва сводка қайта ҳисобланади."
msgstr "— будет перенесено в столбец. Сумма и сводка пересчитаются."

#: jobs/templates/jobs/job.html:2324
msgid "устунига ўтказилсинми?"
msgstr "— перенести в столбец?"

#: jobs/templates/jobs/job.html:2324
msgid "Ҳа, ўтказиш"
msgstr "Да, перенести"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<p>Тепада: смета номи, қайси локал ва ресурс билан нархлангани, жами сумма (Всего с НДС).</p>"
msgstr ""
"<p>Вверху: название сметы, с какой локальной и каким ресурсом расценена, общая сумма (Всего с НДС).</p>"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<p><span class='rounded bg-rose-50 px-1 text-rose-800'>N та нархланмади</span> — нархи топилмаган қаторлар. Улар суммага кирмаган.</p>"
msgstr ""
"<p><span class='rounded bg-rose-50 px-1 text-rose-800'>N не расценено</span> — строки, для которых цена не найдена. В сумму они не вошли.</p>"

#: jobs/templates/jobs/job.html:2547
msgid "Смета 3 босқичда тайёр бўлади"
msgstr "Смета готовится в 3 шага"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<ol><li><b>Топилмаганлар</b> — нархи топилмаган қаторлар</li><li><b>Жадвал</b> — натижани кўриш, кабель ва ускунани ўз устунига ажратиш</li>"
msgstr ""
"<ol><li><b>Не найденные</b> — строки без найденной цены</li><li><b>Таблица</b> — просмотр результата, разделение кабеля и оборудования по своим столбцам</li>"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<li><b>Сводка ва фоизлар</b> — устамалар ва юклаб олиш</li></ol><div class='tip'>Яшил ✓ — босқич тайёр. «Қўшимча»да — статистика ва созламалар.</div>"
msgstr ""

#: jobs/templates/jobs/job.html:2547
msgid "1-босқич: топилмаганлар"
msgstr "Шаг 1: не найденные"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<p>Ҳар бир қаторда сабаби ёзилган: <b>топилмади</b>, <b>ўхшаш</b>, <b>2 та номзод</b>, <b>бирлик бошқа</b>, <b>нарх йўқ</b>.</p>"
msgstr ""
"<p>В каждой строке указана причина: <b>не найдено</b>, <b>похоже</b>, <b>2 кандидата</b>, <b>другая единица</b>, <b>нет цены</b>.</p>"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<p>Нима қилиш керак:</p><ol><li>Турини танланг</li><li>Кераксизини белгидан чиқаринг</li>"
msgstr "<p>Что делать:</p><ol><li>Выберите тип</li><li>Снимите отметку с лишних</li>"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<li><b class='text-amber-700'>«Яқин нархни қўйиш»</b> ёки <b class='text-rose-700'>ёзувни олиб ташлаш</b> (бўлим номлари учун)</li></ol>"
msgstr ""
"<li><b class='text-amber-700'>«Поставить близкую цену»</b> или <b class='text-rose-700'>убрать пометку</b> (для названий разделов)</li></ol>"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<div class='tip'>Сабаб ёнидаги <span class='help-q'>?</span> — нимани билдиришини айтади.</div>"
msgstr ""
"<div class='tip'><span class='help-q'>?</span> рядом с причиной объясняет, что она значит.</div>"

#: jobs/templates/jobs/job.html:2547
msgid "2-босқич: кабель ва ускунани ажратиш"
msgstr "Шаг 2: разделение кабеля и оборудования"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<p>Тизим кабель (L) ва ускуна (M) бўлиши мумкин бўлган материалларни <b>таклиф қилади</b> — ўзи кўчирмайди.</p>"
msgstr ""
"<p>Система <b>предлагает</b> материалы, которые могут быть кабелем (L) или оборудованием (M), — сама не переносит.</p>"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<ul><li><b>«Кўриб чиқиш»</b> — жадвалда белгиланади</li><li><b>«Ҳаммасини ажратиш»</b> — ўз устунига ўтказади</li></ul><div class='tip'>Тугагач — «текширилди»ни босинг.</div>"
msgstr ""
"<ul><li><b>«Просмотреть»</b> — отмечается в таблице</li><li><b>«Разделить всё»</b> — переносит в свой столбец</li></ul><div class='tip'>В конце нажмите «проверено».</div>"

#: jobs/templates/jobs/job.html:2547
msgid "Жадвал — натижанинг ўзи"
msgstr "Таблица — сам результат"

#: jobs/templates/jobs/job.html:2547
msgid "<p>Excel'дагидек кўриниш. Тепадаги чиплар билан фильтрланг:</p>"
msgstr "<p>Вид как в Excel. Фильтруйте чипами вверху:</p>"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<ul><li><span class='tour-dot bg-rose-500'></span> нархланмади</li><li><span class='tour-dot bg-amber-400'></span> нарх таклифи бор</li><li><span class='tour-dot bg-sky-500'></span> қўлда нархланган</li></ul>"
msgstr ""
"<ul><li><span class='tour-dot bg-rose-500'></span> не расценено</li><li><span class='tour-dot bg-amber-400'></span> есть предложение цены</li><li><span class='tour-dot bg-sky-500'></span> расценено вручную</li></ul>"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<div class='tip'>Қаторни босинг — пастда панел чиқади. Қизил G катагини боссангиз — нархни шу ерда ёзасиз.</div>"
msgstr ""
"<div class='tip'>Нажмите на строку — внизу появится панель. Нажмите на красную ячейку G — цену можно ввести прямо здесь.</div>"

#: jobs/templates/jobs/job.html:2547
msgid "3-босқич: сводка ва фоизлар"
msgstr "Шаг 3: сводка и проценты"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<p>Устама фоизлар: накладные, прибыль, НДС ва бошқалар. Ўзгартирсангиз — сумма дарҳол қайта ҳисобланади.</p>"
msgstr ""
"<p>Проценты начислений: накладные, прибыль, НДС и другие. При изменении сумма сразу пересчитывается.</p>"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<ul><li><b>сариқ</b> — стандартдан ўзгартирилган</li><li><b>«Эслаб қолинган фоизлар»</b> — олдинги сметангиздагилар</li></ul>"
msgstr ""
"<ul><li><b>жёлтый</b> — изменено относительно стандарта</li><li><b>«Запомненные проценты»</b> — из вашей предыдущей сметы</li></ul>"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<p>Тайёр Excel: нархлар, сводка ва «LOG» листи. Ҳамма ўзгаришларингиз (нарх, устун, фоиз) киради.</p>"
msgstr ""
"<p>Готовый Excel: цены, сводка и лист «LOG». Входят все ваши изменения (цена, столбец, процент).</p>"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<div class='tip'>Нархсиз қаторлар Excel'да қизил бўлиб қолади — у ерда нарх ёзсангиз, сумма ўзи ҳисобланади.</div>"
msgstr ""
"<div class='tip'>Строки без цены в Excel останутся красными — если вписать там цену, сумма посчитается сама.</div>"

#: jobs/templates/jobs/job.html:2547
msgid ""
"<ul><li>Статистика</li><li>Муаммоли қаторлар рўйхати</li><li>Созламалар — бошқа лист ёки режимда қайта нархлаш</li></ul>"
msgstr ""
"<ul><li>Статистика</li><li>Список проблемных строк</li><li>Настройки — расценить заново с другим листом или режимом</li></ul>"

#: jobs/templates/jobs/landing.html:6
msgid ""
"/* ===== бош қисм: тепада сарлавҳа ва тушунтириш, пастда — смета «расми» ҳошия изоҳлари билан ===== */ .hero { position: relative; isolation: isolate; overflow-x: clip; border-bottom: 1px solid var(--line); } .hero::before { content: \"\"; position: absolute; inset: 280px 0 0; z-index: -1; background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px); background-size: 24px 24px; -webkit-mask-image: linear-gradient(transparent, #000 25%, #000 70%, transparent); mask-image: linear-gradient(transparent, #000 25%, #000 70%, transparent); } .hero-top { display: grid; gap: 24px; padding-top: clamp(40px, 6vw, 88px); } @media (min-width: 1100px) { .hero-top { grid-template-columns: minmax(0, 13fr) minmax(0, 9fr); gap: 72px; align-items: end; } } .hero h1 { font-size: clamp(2.3rem, 1.1rem + 3.4vw, 4.5rem); line-height: .98; font-weight: 650; letter-spacing: -.038em; text-wrap: balance; } .hero h1 em { font-style: normal; color: var(--acc); } .hero-side { display: grid; gap: 22px; padding-bottom: 6px; } .hero .lead { font-size: 16.5px; line-height: 1.6; color: var(--ink-2); max-width: 34em; } .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; } .hero-note { font: 500 12px/1.5 var(--fm); color: var(--mute); } .shot { position: relative; margin-top: clamp(40px, 5vw, 72px); display: grid; gap: 22px; } @media (min-width: 1100px) { .shot { grid-template-columns: minmax(0, 1fr) 248px; gap: 0; } } .sheet { min-width: 0; background: #fff; border: 1px solid var(--line-2); box-shadow: 0 30px 60px -36px rgba(13, 21, 34, .35); } .sheet-bar { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid var(--line); font: 500 12px var(--fm); color: var(--ink-2); } .sheet-bar .xl { flex: none; display: grid; place-items: center; width: 18px; height: 18px; border-radius: 3px; background: #1d6f42; color: #fff; font: 700 10px var(--ff); } .sheet-bar .fn { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .sheet-bar .st { margin-left: auto; flex: none; display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; color: var(--acc); } .sheet-bar .st::before { content: \"\"; width: 6px; height: 6px; border-radius: 50%; background: currentColor; } .sheet-scroll { overflow-x: auto; } .xt { width: 100%; min-width: 600px; border-collapse: collapse; font: 13px/1.35 var(--ff); color: var(--ink); } .xt th, .xt td { border: 1px solid #e6e9ed; padding: 7px 10px; white-space: nowrap; } .xt thead th { background: #f5f6f8; color: #6a7380; font: 500 11px var(--fm); text-align: center; } .xt thead th.l { text-align: left; } .xt td.rn { background: #f5f6f8; color: #8a929d; font: 500 11px var(--fm); text-align: center; width: 36px; } .xt td.n { text-align: right; font-family: var(--fm); font-size: 12.5px; } .xt tr.w td:not(.rn) { font-weight: 600; background: #fafbfc; } .xt td.pr { background: var(--acc-soft); color: var(--acc-ink); font-weight: 600; } .xt td.nf { background: var(--bad-soft); color: var(--bad); font: 600 11.5px var(--fm); text-align: center; } .xt td.dim { color: #9aa2ad; } /* белги: катакдаги ва ҳошиядаги рақам бир хил — кўз уларни дарҳол боғлайди */ .mk { display: inline-grid; place-items: center; width: 17px; height: 17px; margin-right: 7px; border-radius: 2px; background: var(--ink); color: #fff; font: 600 10px/1 var(--fm); font-style: normal; vertical-align: 1px; } .nf .mk { background: var(--bad); } .sheet-foot { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); } .sheet-foot div { padding: 11px 14px; font-size: 12px; color: var(--mute); min-width: 0; } .sheet-foot div + div { border-left: 1px solid var(--line); } .sheet-foot b { display: block; font: 600 16px var(--fm); color: var(--ink); } .sheet-foot .bad { color: var(--bad); } .notes { position: relative; display: grid; gap: 14px; list-style: none; } @media (min-width: 640px) { .notes { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; } } .notes li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 2px; font-size: 13.5px; line-height: 1.5; color: var(--ink-2); } .notes li b { color: var(--ink); font-weight: 600; } .notes .mk { margin-top: 2px; } .notes li:nth-child(2) .mk { background: var(--bad); } /* катта экранда изоҳ ўз қаторининг рўпарасида туради (JS жойлайди), сметагача узуқ чизиқ */ @media (min-width: 1100px) { .notes { display: block; padding-left: 40px; } .notes li { position: relative; margin-bottom: 18px; } .notes.is-placed li { position: absolute; left: 40px; right: 0; margin: 0; } .notes li::before { content: \"\"; position: absolute; left: -40px; top: 10px; width: 32px; border-top: 1px solid var(--line-2); } } .facts { display: grid; gap: 14px; padding-block: 28px clamp(44px, 5vw, 72px); } @media (min-width: 1100px) { .facts { grid-template-columns: minmax(0, 1fr) 248px; } .facts-k { order: 2; padding: 14px 0 0 40px; } } .facts-k { font: 500 12px/1.6 var(--fm); color: var(--mute); } .measure { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--ink); } @media (min-width: 800px) { .measure { grid-template-columns: repeat(4, minmax(0, 1fr)); } } .measure div { padding: 14px 16px 0 0; min-width: 0; } .measure b { display: block; font: 600 clamp(1.5rem, 1.1rem + 1vw, 2.1rem)/1 var(--fm); letter-spacing: -.03em; } .measure span { display: block; margin-top: 8px; font-size: 13.5px; color: var(--ink-2); line-height: 1.45; } /* ===== қадамлар ===== */ .chain { display: grid; gap: 28px; counter-reset: st; } @media (min-width: 900px) { .chain { grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); gap: 0; } } .chain li { list-style: none; position: relative; padding-top: 34px; min-width: 0; } @media (min-width: 900px) { .chain li { padding-right: 32px; } } .chain li::before { content: \"\"; position: absolute; left: 0; right: 0; top: 10px; height: 1px; background: var(--ink); } .chain li::after { counter-increment: st; content: \"0\" counter(st); position: absolute; top: 0; left: 8px; padding: 0 8px; background: var(--paper); font: 600 13px/20px var(--fm); color: var(--ink); } .chain .tk, .chain .tk-end { position: absolute; top: 3px; width: 1px; height: 15px; background: var(--ink); } .chain .tk { left: 0; } .chain .tk-end { right: 0; } .chain h3 { font-size: 1.15rem; font-weight: 600; } .chain p { margin-top: 8px; color: var(--ink-2); line-height: 1.6; font-size: 15px; max-width: 26em; } .sec-h .lnk { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 15px; } .sec-h .lnk svg { width: 15px; height: 15px; } /* ===== икки бўлим ===== */ .mods { display: grid; gap: 48px; } @media (min-width: 1000px) { .mods { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 5vw, 96px); } } .mod { border-top: 2px solid var(--ink); padding-top: 22px; display: grid; gap: 16px; align-content: start; min-width: 0; } .mod-k { display: flex; justify-content: space-between; font: 500 12px var(--fm); letter-spacing: .05em; text-transform: uppercase; color: var(--mute); } .mod h3 { font-size: clamp(1.4rem, 1.1rem + .8vw, 1.9rem); font-weight: 600; letter-spacing: -.015em; } .mod p { color: var(--ink-2); line-height: 1.65; max-width: 36em; } .ticks { display: grid; border-top: 1px solid var(--line); } .ticks li { list-style: none; display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; padding: 11px 0; border-bottom: 1px solid var(--line); font-size: 15px; } .ticks li::before { content: \"\"; width: 12px; height: 7px; margin-top: 6px; border-left: 2px solid var(--acc); border-bottom: 2px solid var(--acc); transform: rotate(-45deg); } .mini { border: 1px solid var(--line-2); background: #fff; overflow-x: auto; } .mini table { width: 100%; min-width: 440px; border-collapse: collapse; font-size: 13px; } .mini th, .mini td { padding: 8px 12px; border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; } .mini th { font: 500 11px var(--fm); text-transform: uppercase; letter-spacing: .04em; color: var(--mute); background: #f7f8f9; } .mini th:first-child, .mini td:first-child { text-align: left; white-space: normal; } .mini td.n { font-family: var(--fm); } .mini td.now { background: var(--acc-soft); color: var(--acc-ink); font-weight: 600; } .mini tr.r td { color: var(--mute); font-size: 12.5px; } .mini tr.r td:first-child { padding-left: 26px; } .mini caption { caption-side: bottom; text-align: left; padding: 9px 12px; font-size: 12px; color: var(--mute); border-top: 1px solid var(--line); } /* ===== хавфсизлик: битта ихчам банд ===== */ .secu { padding-block: clamp(48px, 6vw, 80px); border-bottom: 1px solid var(--line); background: #f1f3f5; } .secu-in { display: grid; gap: 28px 48px; } @media (min-width: 1000px) { .secu-in { grid-template-columns: minmax(0, 4fr) repeat(3, minmax(0, 3fr)); } } .secu h2 { font-size: clamp(1.5rem, 1.1rem + 1.1vw, 2.1rem); line-height: 1.1; font-weight: 600; letter-spacing: -.02em; margin-top: 12px; max-width: 12em; } .secu article { display: grid; gap: 8px; align-content: start; padding-top: 16px; border-top: 1px solid var(--line-2); } .secu article svg { width: 18px; height: 18px; color: var(--acc); } .secu h3 { font-size: 15.5px; font-weight: 600; } .secu p { font-size: 14px; line-height: 1.6; color: var(--ink-2); } /* ===== саволлар ===== */ .faq-in { display: grid; gap: 28px 48px; } @media (min-width: 1000px) { .faq-in { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } } .faq { border-top: 1px solid var(--ink); } .faq details { border-bottom: 1px solid var(--line); } .faq summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; cursor: var(--cur-hand, pointer); list-style: none; font-size: 1.05rem; font-weight: 600; } .faq summary::-webkit-details-marker { display: none; } .faq summary svg { flex: none; width: 16px; height: 16px; color: var(--mute); transition: transform .15s; } .faq details[open] summary svg { transform: rotate(45deg); color: var(--ink); } .faq summary:hover { color: var(--acc); } .faq details p { max-width: 42em; padding: 0 0 20px; color: var(--ink-2); line-height: 1.65; } .faq-more { margin-top: 18px; font-size: 14.5px; color: var(--ink-2); } /* ===== якун ===== */ .final { background: var(--ink); color: #fff; } .final-in { display: grid; gap: 40px; padding-block: clamp(56px, 7vw, 100px); } @media (min-width: 1000px) { .final-in { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; } } .final h2 { font-size: clamp(1.9rem, 1.2rem + 2vw, 3.1rem); font-weight: 600; line-height: 1.06; letter-spacing: -.024em; max-width: 18em; text-wrap: balance; } .final p { margin-top: 14px; color: #a9b3c1; max-width: 40em; line-height: 1.6; } .final .cta { margin-top: 28px; } .final .btn-p { background: #fff; color: var(--ink); } .final .btn-p:hover { background: #e9f5ef; } .final .lnk { color: #fff; } .contact { border-top: 1px solid rgba(255, 255, 255, .2); padding-top: 18px; display: grid; gap: 10px; } .contact h3 { font: 500 12px/1.5 var(--fm); letter-spacing: .05em; text-transform: uppercase; color: #8f9bab; } .contact a { display: inline-flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; font-weight: 500; } .contact a:hover { text-decoration: underline; text-underline-offset: 4px; } .contact svg { width: 16px; height: 16px; color: #6ee7b7; }"
