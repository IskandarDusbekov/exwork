#: accounts/emails.py:12
msgid "mhisobot: паролни тиклаш коди {code}"
msgstr "mhisobot: код восстановления пароля {code}"

#: accounts/emails.py:13
msgid "mhisobot: email тасдиқлаш коди {code}"
msgstr "mhisobot: код подтверждения email {code}"

#: accounts/emails.py:34 accounts/emails.py:35
#: accounts/templates/accounts/reset_request.html:3
msgid "Паролни тиклаш"
msgstr "Восстановление пароля"

#: accounts/emails.py:34
msgid "mhisobot тизимида паролингизни тиклаш сўралди."
msgstr "В системе mhisobot запрошено восстановление вашего пароля."

#: accounts/emails.py:36
msgid "Ёки бошқа қурилмадан бўлса — тугмани босиб, дарров янги пароль қўйинг:"
msgstr ""
"Или, если вы на другом устройстве, нажмите кнопку и сразу задайте новый пароль:"

#: accounts/emails.py:37
msgid "Янги пароль қўйиш"
msgstr "Задать новый пароль"

#: accounts/emails.py:37
msgid "{0} соат амал қилади, бир марта ишлайди"
msgstr "Действует {0} ч., срабатывает один раз"

#: accounts/emails.py:38
msgid ""
"Буни сиз сўрамаган бўлсангиз — хатни эътиборсиз қолдиринг, паролингиз ўзгармайди."
msgstr ""
"Если вы этого не запрашивали — просто проигнорируйте письмо, ваш пароль не изменится."

#: accounts/emails.py:44
msgid "Email манзилини тасдиқлаш"
msgstr "Подтверждение адреса email"

#: accounts/emails.py:45
msgid ""
"mhisobot тизимида шу манзил билан ҳисоб очилди. Бу почта сизники эканини тасдиқланг."
msgstr ""
"В системе mhisobot создан аккаунт с этим адресом. Подтвердите, что это ваша почта."

#: accounts/emails.py:46
msgid "Email тасдиқлаш"
msgstr "Подтверждение email"

#: accounts/emails.py:47
msgid "Ёки бошқа қурилмадан бўлса — тугмани босинг, email дарров тасдиқланади:"
msgstr ""
"Или, если вы на другом устройстве, нажмите кнопку — email будет подтверждён сразу:"

#: accounts/emails.py:48
msgid "Email'ни тасдиқлаш"
msgstr "Подтвердить email"

#: accounts/emails.py:48
msgid "{0} соат амал қилади"
msgstr "Действует {0} ч."

#: accounts/emails.py:49
msgid ""
"Ҳисобни сиз очмаган бўлсангиз — хатни эътиборсиз қолдиринг: тасдиқланмаган ҳисоб шу почта орқали паролни тиклай олмайди."
msgstr ""
"Если аккаунт создавали не вы — проигнорируйте письмо: неподтверждённый аккаунт не сможет восстановить пароль через эту почту."

#: accounts/forms.py:10
msgid "Пароль камида {min} белгидан иборат бўлсин."
msgstr "Пароль должен содержать не менее {min} символов."

#: accounts/forms.py:11
msgid "Бу пароль жуда кенг тарқалган — бошқасини танланг."
msgstr "Этот пароль слишком распространён — выберите другой."

#: accounts/forms.py:12
msgid "Пароль фақат рақамлардан иборат бўлмасин."
msgstr "Пароль не должен состоять только из цифр."

#: accounts/forms.py:13
msgid "Пароль исм, фамилия ёки email'га жуда ўхшаш."
msgstr "Пароль слишком похож на имя, фамилию или email."

#: accounts/forms.py:56 accounts/forms.py:100
msgid "Пароль"
msgstr "Пароль"

#: accounts/forms.py:67
msgid "Email'ни киритинг."
msgstr "Введите email."

#: accounts/forms.py:67 accounts/forms.py:117
msgid "Email нотўғри ёзилган."
msgstr "Email указан неверно."

#: accounts/forms.py:71 accounts/templates/accounts/reset_confirm.html:9
msgid "Янги пароль"
msgstr "Новый пароль"

#: accounts/forms.py:73 accounts/forms.py:102
msgid "Паролни такрорланг"
msgstr "Повторите пароль"

#: accounts/forms.py:80 accounts/forms.py:111
msgid "Тўлдиринг."
msgstr "Заполните поле."

#: accounts/forms.py:86 accounts/forms.py:129
msgid "Пароллар бир хил эмас."
msgstr "Пароли не совпадают."

#: accounts/forms.py:94
msgid "Исм"
msgstr "Имя"

#: accounts/forms.py:96
msgid "Фамилия"
msgstr "Фамилия"

#: accounts/forms.py:104
msgid "Фойдаланиш шартларига розиман"
msgstr "Я принимаю условия использования"

#: accounts/forms.py:114
msgid "Рўйхатдан ўтиш учун шартларга рози бўлинг."
msgstr "Для регистрации примите условия использования."

#: accounts/forms.py:122
msgid "Бу email билан ҳисоб бор — «Кириш»ни босинг."
msgstr "Аккаунт с этим email уже есть — нажмите «Войти»."

#: accounts/views.py:29
msgid "Жуда кўп уриниш. 15 дақиқадан кейин қайта уриниб кўринг."
msgstr "Слишком много попыток. Попробуйте снова через 15 минут."

#: accounts/views.py:58
msgid "Email ва паролни киритинг."
msgstr "Введите email и пароль."

#: accounts/views.py:67
msgid "Email ёки пароль нотўғри."
msgstr "Неверный email или пароль."

#: accounts/views.py:102
msgid "Вақт тугади — қайтадан киринг."
msgstr "Время истекло — войдите заново."

#: accounts/views.py:119
msgid "Код кўп марта нотўғри киритилди — қайтадан киринг."
msgstr "Код много раз введён неверно — войдите заново."

#: accounts/views.py:121
msgid "Код нотўғри ёки эскирган — иловадаги янги кодни киритинг."
msgstr "Код неверный или устарел — введите новый код из приложения."

#: accounts/views.py:132
msgid "Бу код ишлатилган — иловадаги кейинги кодни кутинг."
msgstr "Этот код уже использован — дождитесь следующего кода в приложении."

#: accounts/views.py:153
msgid ""
"Код нотўғри. Телефондаги соат тўғрилигини ва калит тўлиқ киритилганини текширинг."
msgstr ""
"Код неверный. Проверьте, что время на телефоне точное и ключ введён полностью."

#: accounts/views.py:160
msgid "Икки босқичли кириш ёқилди: энди ҳар киришда иловадаги код сўралади."
msgstr ""
"Двухэтапный вход включён: теперь при каждом входе будет запрашиваться код из приложения."

#: accounts/views.py:272 accounts/views.py:387
msgid "Код нотўғри. Яна {0} марта уриниш мумкин."
msgstr "Код неверный. Осталось попыток: {0}."

#: accounts/views.py:306
msgid "Пароль ўзгартирилди — янги парол билан киринг."
msgstr "Пароль изменён — войдите с новым паролем."

#: accounts/views.py:318
msgid ""
"Тасдиқлаш хати юборилмади — почта сервери ишламаяпти. Бироздан кейин «Кодни қайта юбориш»ни босинг."
msgstr ""
"Письмо с подтверждением не отправлено — почтовый сервер не работает. Чуть позже нажмите «Отправить код ещё раз»."

#: accounts/views.py:352
msgid "{0} сония"
msgstr "{0} сек."

#: accounts/views.py:352
msgid "{0} дақиқа"
msgstr "{0} мин."

#: accounts/views.py:369
msgid "Янги хатни {0}дан кейин юбориш мумкин."
msgstr "Новое письмо можно отправить через {0}."

#: accounts/views.py:371
msgid "Янги код {0} га юборилди."
msgstr "Новый код отправлен на {0}."

#: accounts/views.py:378
msgid "Код эскирди ёки кўп марта хато киритилди — янги код сўранг."
msgstr "Код устарел или много раз введён неверно — запросите новый код."

#: accounts/views.py:388
msgid "Код кўп марта хато киритилди — янги код сўранг."
msgstr "Код много раз введён неверно — запросите новый код."

#: jobs/archives.py:94
