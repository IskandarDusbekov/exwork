#: jobs/templates/jobs/_sheet_viewer.html:34
msgid "Локал — нархланадиган смета"
msgstr "Lokal — narxlanadigan smeta"

#: jobs/templates/jobs/_sheet_viewer.html:34
msgid "Ресурс — нархлар рўйхати (RES)"
msgstr "Resurs — narxlar roʻyxati (RES)"

#: jobs/templates/jobs/_sheet_viewer.html:34
