low: hidden; text-overflow: ellipsis; white-space: nowrap; } .sheet-bar .st { margin-left: auto; flex: none; display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; color: var(--acc); } .sheet-bar .st::before { content: \"\"; width: 6px; height: 6px; border-radius: 50%; background: currentColor; } .sheet-scroll { overflow-x: auto; } .xt { width: 100%; min-width: 600px; border-collapse: collapse; font: 13px/1.35 var(--ff); color: var(--ink); } .xt th, .xt td { border: 1px solid #e6e9ed; padding: 7px 10px; white-space: nowrap; } .xt thead th { background: #f5f6f8; color: #6a7380; font: 500 11px var(--fm); text-align: center; } .xt thead th.l { text-align: left; } .xt td.rn { background: #f5f6f8; color: #8a929d; font: 500 11px var(--fm); text-align: center; width: 36px; } .xt td.n { text-align: right; font-family: var(--fm); font-size: 12.5px; } .xt tr.w td:not(.rn) { font-weight: 600; background: #fafbfc; } .xt td.pr { background: var(--acc-soft); color: var(--acc-ink); font-weight: 600; } .xt td.nf { background: var(--bad-soft); color: var(--bad); font: 600 11.5px var(--fm); text-align: center; } .xt td.dim { color: #9aa2ad; } /* белги: катакдаги ва ҳошиядаги рақам бир хил — кўз уларни дарҳол боғлайди */ .mk { display: inline-grid; place-items: center; width: 17px; height: 17px; margin-right: 7px; border-radius: 2px; background: var(--ink); color: #fff; font: 600 10px/1 var(--fm); font-style: normal; vertical-align: 1px; } .nf .mk { background: var(--bad); } .sheet-foot { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); } .sheet-foot div { padding: 11px 14px; font-size: 12px; color: var(--mute); min-width: 0; } .sheet-foot div + div { border-left: 1px solid var(--line); } .sheet-foot b { display: block; font: 600 16px var(--fm); color: var(--ink); } .sheet-foot .bad { color: var(--bad); } .notes { position: relative; display: grid; gap: 14px; list-style: none; } @media (min-width: 640px) { .notes { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; } } .notes li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 2px; font-size: 13.5px; line-height: 1.5; color: var(--ink-2); } .notes li b { color: var(--ink); font-weight: 600; } .notes .mk { margin-top: 2px; } .notes li:nth-child(2) .mk { background: var(--bad); } /* катта экранда изоҳ ўз қаторининг рўпарасида туради (JS жойлайди), сметагача узуқ чизиқ */ @media (min-width: 1100px) { .notes { display: block; padding-left: 40px; } .notes li { position: relative; margin-bottom: 18px; } .notes.is-placed li { position: absolute; left: 40px; right: 0; margin: 0; } .notes li::before { content: \"\"; position: absolute; left: -40px; top: 10px; width: 32px; border-top: 1px solid var(--line-2); } } .facts { display: grid; gap: 14px; padding-block: 28px clamp(44px, 5vw, 72px); } @media (min-width: 1100px) { .facts { grid-template-columns: minmax(0, 1fr) 248px; } .facts-k { order: 2; padding: 14px 0 0 40px; } } .facts-k { font: 500 12px/1.6 var(--fm); color: var(--mute); } .measure { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--ink); } @media (min-width: 800px) { .measure { grid-template-columns: repeat(4, minmax(0, 1fr)); } } .measure div { padding: 14px 16px 0 0; min-width: 0; } .measure b { display: block; font: 600 clamp(1.5rem, 1.1rem + 1vw, 2.1rem)/1 var(--fm); letter-spacing: -.03em; } .measure span { display: block; margin-top: 8px; font-size: 13.5px; color: var(--ink-2); line-height: 1.45; } /* ===== қадамлар ===== */ .chain { display: grid; gap: 28px; counter-reset: st; } @media (min-width: 900px) { .chain { grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); gap: 0; } } .chain li { list-style: none; position: relative; padding-top: 34px; min-width: 0; } @media (min-width: 900px) { .chain li { padding-right: 32px; } } .chain li::before { content: \"\"; position: absolute; left: 0; right: 0; top: 10px; height: 1px; background: var(--ink); } .chain li::after { counter-increment: st; content: \"0\" counter(st); position: absolute; top: 0; left: 8px; padding: 0 8px; background: var(--paper); font: 600 13px/20px var(--fm); color: var(--ink); } .chain .tk, .chain .tk-end { position: absolute; top: 3px; width: 1px; height: 15px; background: var(--ink); } .chain .tk { left: 0; } .chain .tk-end { right: 0; } .chain h3 { font-size: 1.15rem; font-weight: 600; } .chain p { margin-top: 8px; color: var(--ink-2); line-height: 1.6; font-size: 15px; max-width: 26em; } .sec-h .lnk { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 15px; } .sec-h .lnk svg { width: 15px; height: 15px; } /* ===== икки бўлим ===== */ .mods { display: grid; gap: 48px; } @media (min-width: 1000px) { .mods { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 5vw, 96px); } } .mod { border-top: 2px solid var(--ink); padding-top: 22px; display: grid; gap: 16px; align-content: start; min-width: 0; } .mod-k { display: flex; justify-content: space-between; font: 500 12px var(--fm); letter-spacing: .05em; text-transform: uppercase; color: var(--mute); } .mod h3 { font-size: clamp(1.4rem, 1.1rem + .8vw, 1.9rem); font-weight: 600; letter-spacing: -.015em; } .mod p { color: var(--ink-2); line-height: 1.65; max-width: 36em; } .ticks { display: grid; border-top: 1px solid var(--line); } .ticks li { list-style: none; display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; padding: 11px 0; border-bottom: 1px solid var(--line); font-size: 15px; } .ticks li::before { content: \"\"; width: 12px; height: 7px; margin-top: 6px; border-left: 2px solid var(--acc); border-bottom: 2px solid var(--acc); transform: rotate(-45deg); } .mini { border: 1px solid var(--line-2); background: #fff; overflow-x: auto; } .mini table { width: 100%; min-width: 440px; border-collapse: collapse; font-size: 13px; } .mini th, .mini td { padding: 8px 12px; border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; } .mini th { font: 500 11px var(--fm); text-transform: uppercase; letter-spacing: .04em; color: var(--mute); background: #f7f8f9; } .mini th:first-child, .mini td:first-child { text-align: left; white-space: normal; } .mini td.n { font-family: var(--fm); } .mini td.now { background: var(--acc-soft); color: var(--acc-ink); font-weight: 600; } .mini tr.r td { color: var(--mute); font-size: 12.5px; } .mini tr.r td:first-child { padding-left: 26px; } .mini caption { caption-side: bottom; text-align: left; padding: 9px 12px; font-size: 12px; color: var(--mute); border-top: 1px solid var(--line); } /* ===== хавфсизлик: битта ихчам банд ===== */ .secu { padding-block: clamp(48px, 6vw, 80px); border-bottom: 1px solid var(--line); background: #f1f3f5; } .secu-in { display: grid; gap: 28px 48px; } @media (min-width: 1000px) { .secu-in { grid-template-columns: minmax(0, 4fr) repeat(3, minmax(0, 3fr)); } } .secu h2 { font-size: clamp(1.5rem, 1.1rem + 1.1vw, 2.1rem); line-height: 1.1; font-weight: 600; letter-spacing: -.02em; margin-top: 12px; max-width: 12em; } .secu article { display: grid; gap: 8px; align-content: start; padding-top: 16px; border-top: 1px solid var(--line-2); } .secu article svg { width: 18px; height: 18px; color: var(--acc); } .secu h3 { font-size: 15.5px; font-weight: 600; } .secu p { font-size: 14px; line-height: 1.6; color: var(--ink-2); } /* ===== саволлар ===== */ .faq-in { display: grid; gap: 28px 48px; } @media (min-width: 1000px) { .faq-in { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } } .faq { border-top: 1px solid var(--ink); } .faq details { border-bottom: 1px solid var(--line); } .faq summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; cursor: var(--cur-hand, pointer); list-style: none; font-size: 1.05rem; font-weight: 600; } .faq summary::-webkit-details-marker { display: none; } .faq summary svg { flex: none; width: 16px; height: 16px; color: var(--mute); transit