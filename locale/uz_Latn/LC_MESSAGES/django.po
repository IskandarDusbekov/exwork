msgstr "Eskilari →"

#: billing/templates/billing/profile.html:299
msgid "Ҳали тўлов йўқ"
msgstr "Hali toʻlov yoʻq"

#: billing/templates/billing/profile.html:306
msgid "техназор объекти · тарифдан"
msgstr "texnazor obʼyekti · tarifdan"

#: billing/templates/billing/profile.html:306
