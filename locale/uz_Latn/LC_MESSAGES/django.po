msgid "Ҳажм ёзилмаса ҳам {0} сўм чиқяпти"
msgstr "Hajm yozilmasa ham {0} soʻm chiqyapti"

#: texnazor/sheet.py:1253
msgid ""
"Файлда айрим суммалар ҳажмга боғланмаган (формула ўрнига сон ёки бошқа устунга ҳавола): {0}. Бу пул ҳар бир далолатномага тушади."
msgstr ""
"Faylda ayrim summalar hajmga bogʻlanmagan (formula oʻrniga son yoki boshqa ustunga havola): {0}. Bu pul har bir dalolatnomaga tushadi."

#: texnazor/sheet.py:1255
msgid ""
"Файлда айрим суммалар ҳажмга боғланмаган (формула ўрнига сон ёки бошқа устунга ҳавола). Бу пул ҳар бир далолатномага тушади."
msgstr ""
"Faylda ayrim summalar hajmga bogʻlanmagan (formula oʻrniga son yoki boshqa ustunga havola). Bu pul har bir dalolatnomaga tushadi."

#: texnazor/sheet.py:1259
msgid "Ярим ҳажмда жами {0:.1f}% чиқди (50% бўлиши керак)"
msgstr "Yarim hajmda jami {0:.1f}% chiqdi (50% boʻlishi kerak)"

#: texnazor/sheet.py:1260
msgid ""
"Суммаларнинг бир қисми ҳажмга мутаносиб эмас — далолатнома фоизи нотўғри кўрсатилади."
msgstr ""
"Summalarning bir qismi hajmga mutanosib emas — dalolatnoma foizi notoʻgʻri koʻrsatiladi."

#: texnazor/sheet.py:1262
msgid "Тизим ҳисоби {0}, файлда {1}"
msgstr "Tizim hisobi {0}, faylda {1}"

#: texnazor/sheet.py:1263
msgid ""
"Тўлиқ ҳажмда ҳам жами файлдагидан фарқ қиляпти — формулаларнинг бир қисми тушунилмаган."
msgstr ""
"Toʻliq hajmda ham jami fayldagidan farq qilyapti — formulalarning bir qismi tushunilmagan."

#: texnazor/tasks.py:71 texnazor/tasks.py:83 texnazor/tasks.py:96
msgid "кутилмаган хато"
msgstr "kutilmagan xato"

