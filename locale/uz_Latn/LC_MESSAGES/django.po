msgid "mhisobot: паролни тиклаш коди {code}"
msgstr "mhisobot: parolni tiklash kodi {code}"

#: accounts/emails.py:13
msgid "mhisobot: email тасдиқлаш коди {code}"
msgstr "mhisobot: email tasdiqlash kodi {code}"

#: accounts/emails.py:34 accounts/emails.py:35
#: accounts/templates/accounts/reset_request.html:3
msgid "Паролни тиклаш"
msgstr "Parolni tiklash"

#: accounts/emails.py:34
msgid "mhisobot тизимида паролингизни тиклаш сўралди."
msgstr "mhisobot tizimida parolingizni tiklash soʻraldi."

#: accounts/emails.py:36
msgid "Ёки бошқа қурилмадан бўлса — тугмани босиб, дарров янги пароль қўйинг:"
msgstr "Yoki boshqa qurilmadan boʻlsa — tugmani bosib, darrov yangi parol qoʻying:"

#: accounts/emails.py:37
msgid "Янги пароль қўйиш"
msgstr "Yangi parol qoʻyish"

#: accounts/emails.py:37
msgid "{0} соат амал қилади, бир марта ишлайди"
msgstr "{0} soat amal qiladi, bir marta ishlaydi"

#: accounts/emails.py:38
msgid ""
"Буни сиз сўрамаган бўлсангиз — хатни эътиборсиз қолдиринг, паролингиз ўзгармайди."
msgstr ""
"Buni siz soʻramagan boʻlsangiz — xatni eʼtiborsiz qoldiring, parolingiz oʻzgarmaydi."

#: accounts/emails.py:44
msgid "Email манзилини тасдиқлаш"
msgstr "Email manzilini tasdiqlash"

#: accounts/emails.py:45
msgid ""
"mhisobot тизимида шу манзил билан ҳисоб очилди. Бу почта сизники эканини тасдиқланг."
msgstr ""
"mhisobot tizimida shu manzil bilan hisob ochildi. Bu pochta sizniki ekanini tasdiqlang."

#: accounts/emails.py:46
msgid "Email тасдиқлаш"
msgstr "Email tasdiqlash"

#: accounts/emails.py:47
msgid "Ёки бошқа қурилмадан бўлса — тугмани босинг, email дарров тасдиқланади:"
msgstr "Yoki boshqa qurilmadan boʻlsa — tugmani bosing, email darrov tasdiqlanadi:"

#: accounts/emails.py:48 billing/templates/billing/profile.html:348
msgid "Email'ни тасдиқлаш"
msgstr "Email'ni tasdiqlash"

#: accounts/emails.py:48
msgid "{0} соат амал қилади"
msgstr "{0} soat amal qiladi"

#: accounts/emails.py:49
msgid ""
"Ҳисобни сиз очмаган бўлсангиз — хатни эътиборсиз қолдиринг: тасдиқланмаган ҳисоб шу почта орқали паролни тиклай олмайди."
msgstr ""
"Hisobni siz ochmagan boʻlsangiz — xatni eʼtiborsiz qoldiring: tasdiqlanmagan hisob shu pochta orqali parolni tiklay olmaydi."

#: accounts/forms.py:10
msgid "Пароль камида {min} белгидан иборат бўлсин."
msgstr "Parol kamida {min} belgidan iborat boʻlsin."

#: accounts/forms.py:11
msgid "Бу пароль жуда кенг тарқалган — бошқасини танланг."
msgstr "Bu parol juda keng tarqalgan — boshqasini tanlang."

#: accounts/forms.py:12
msgid "Пароль фақат рақамлардан иборат бўлмасин."
msgstr "Parol faqat raqamlardan iborat boʻlmasin."

#: accounts/forms.py:13
msgid "Пароль исм, фамилия ёки email'га жуда ўхшаш."
msgstr "Parol ism, familiya yoki email'ga juda oʻxshash."

