#: texnazor/services_acts.py:662
msgid "Ҳажм устунини йиғиб бўлмайди — далолатнома шунга ёзилади"
msgstr "Hajm ustunini yigʻib boʻlmaydi — dalolatnoma shunga yoziladi"

#: texnazor/services_acts.py:678
msgid "Тузатиш тури нотўғри"
msgstr "Tuzatish turi notoʻgʻri"

#: texnazor/sheet.py:542 texnazor/sheet.py:583
msgid "Файлда «{0}» листи йўқ"
msgstr "Faylda «{0}» listi yoʻq"

#: texnazor/sheet.py:603
msgid ""
"Бу листда офёрта жадвали топилмади: «Наименование работ…» сарлавҳали қатор йўқ"
msgstr ""
"Bu listda ofyorta jadvali topilmadi: «Naimenovaniye rabot…» sarlavhali qator yoʻq"

#: texnazor/sheet.py:615
msgid ""
"Листда иш қатори топилмади (А устунида 1, 2, 3 … ва 1.1, 1.2 … рақамлар, ёнида номи)"
msgstr ""
"Listda ish qatori topilmadi (A ustunida 1, 2, 3 … va 1.1, 1.2 … raqamlar, yonida nomi)"

#: texnazor/sheet.py:736
msgid "Файлда хато қийматлар бор эди"
msgstr "Faylda xato qiymatlar bor edi"

#: texnazor/sheet.py:737
msgid ""
"{0} та катакда файлда «{1}» каби хато сақланган эди (одатда .xls очилганда матн кўринишидаги сонлар туфайли). Тизим уларни формула бўйича қайта ҳисоблади."
msgstr ""
"{0} ta katakda faylda «{1}» kabi xato saqlangan edi (odatda .xls ochilganda matn koʻrinishidagi sonlar tufayli). Tizim ularni formula boʻyicha qayta hisobladi."

#: texnazor/sheet.py:745
msgid "Сводкада формула йўқ"
msgstr "Svodkada formula yoʻq"

#: texnazor/sheet.py:746
msgid ""
"Офёрта пастидаги сводка (иш ҳақи, фоизлар, ҚҚС) сон сифатида ёзилган. Далолатномаларда сводка қаторлари ҳисобланмайди — фақат иш қаторлари."
msgstr ""
"Ofyorta pastidagi svodka (ish haqi, foizlar, QQS) son sifatida yozilgan. Dalolatnomalarda svodka qatorlari hisoblanmaydi — faqat ish qatorlari."

#: texnazor/sheet.py:759
msgid "Қўлда қўшилган сон далолатномаларда олинмайди (сиз тасдиқлагансиз)"
msgstr "Qoʻlda qoʻshilgan son dalolatnomalarda olinmaydi (siz tasdiqlagansiz)"

#: texnazor/sheet.py:760
msgid ""
"{0} та сводка формуласидаги қўлда қўшилган сон далолатномаларга тушмайди. Офёрта ва «Остатка» файлдагидек (шу сон билан) қолади."
msgstr ""
"{0} ta svodka formulasidagi qoʻlda qoʻshilgan son dalolatnomalarga tushmaydi. Ofyorta va «Ostatka» fayldagidek (shu son bilan) qoladi."

#: texnazor/sheet.py:763
msgid "Сводка формуласида қўлда қўшилган сон бор"
msgstr "Svodka formulasida qoʻlda qoʻshilgan son bor"

#: texnazor/sheet.py:764
msgid ""
"{0} та формулада ҳисобга қўлда сон қўшилган ёки айрилган (масалан {1}-қатор: {2}). Тизим уни файлдагидек қолдиради, шунинг учун бу сон ҳар бир далолатномага тушади (ҳажм ёзилмаса ҳам). Смета тузувчи билан аниқлаштиринг ёки пастдаги тугмани босинг."
msgstr ""
"{0} ta formulada hisobga qoʻlda son qoʻshilgan yoki ayrilgan (masalan {1}-qator: {2}). Tizim uni fayldagidek qoldiradi, shuning uchun bu son har bir dalolatnomaga tushadi (hajm yozilmasa ham). Smeta tuzuvchi bilan aniqlashtiring yoki pastdagi tugmani bosing."

#: texnazor/sheet.py:801
msgid "Ресурслар формуласи тузатилди (сиз тасдиқлагансиз)"
msgstr "Resurslar formulasi tuzatildi (siz tasdiqlagansiz)"

#: texnazor/sheet.py:802
msgid ""
"{0} та ресурс жами ўз иши ҳажмига уланди. Офёрта жами {1} → {2} сўм. Excel ҳисоботга ҳам тузатилган формула ёзилади."
msgstr ""
"{0} ta resurs jami oʻz ishi hajmiga ulandi. Ofyorta jami {1} → {2} soʻm. Excel hisobotga ham tuzatilgan formula yoziladi."

#: texnazor/sheet.py:817
msgid "Ресурслар ўз иши ҳажмига мутаносиб қилинди (сиз тасдиқлагансиз)"
msgstr "Resurslar oʻz ishi hajmiga mutanosib qilindi (siz tasdiqlagansiz)"

#: texnazor/sheet.py:818
msgid ""
"{0} та ресурснинг жами бошқа қатордаги ҳажмга кўпайтирилган эди. Офёрта жами файлдагидек қолди; далолатномада бу ресурслар ўз иши ҳажмига мутаносиб ҳисобланади."
msgstr ""
"{0} ta resursning jami boshqa qatordagi hajmga koʻpaytirilgan edi. Ofyorta jami fayldagidek qoldi; dalolatnomada bu resurslar oʻz ishi hajmiga mutanosib hisoblanadi."

#: texnazor/sheet.py:825
msgid "Ресурслар бошқа қатордаги ҳажмга кўпайтирилган"
msgstr "Resurslar boshqa qatordagi hajmga koʻpaytirilgan"

#: texnazor/sheet.py:826
msgid ""
"{0}-иш ({1}-қатор, ҳажми {2}) ресурсларининг жами ўз иши ҳажмига эмас, {3} га кўпайтирилган — формула кўчирилганда «$» қотиб қолган бўлиши мумкин. Бу пул далолатномада иш ҳажмига мутаносиб ўзгармайди, файлдаги жами ҳам шу қисм бўйича нотўғри бўлиши мумкин. Жами {4} та ишда, {5} та ресурс. Смета тузувчи формулани тузатсин ёки «Мутаносиб қилиш» тугмасини босинг."
msgstr ""
"{0}-ish ({1}-qator, hajmi {2}) resurslarining jami oʻz ishi hajmiga emas, {3} ga koʻpaytirilgan — formula koʻchirilganda «$» qotib qolgan boʻlishi mumkin. Bu pul dalolatnomada ish hajmiga mutanosib oʻzgarmaydi, fayldagi jami ham shu qism boʻyicha notoʻgʻri boʻlishi mumkin. Jami {4} ta ishda, {5} ta resurs. Smeta tuzuvchi formulani tuzatsin yoki «Mutanosib qilish» tugmasini bosing."

#: texnazor/sheet.py:831
msgid "Бошқа листга ҳавола қилувчи формулалар бор"
msgstr "Boshqa listga havola qiluvchi formulalar bor"

#: texnazor/sheet.py:832
msgid ""
"{0} та қаторда формула бошқа листдаги катакни олади (биринчиси {1}-қатор). Бундай катакларда файлда сақланган қиймат олинади (далолатномада ўзгармайди)."
msgstr ""
"{0} ta qatorda formula boshqa listdagi katakni oladi (birinchisi {1}-qator). Bunday kataklarda faylda saqlangan qiymat olinadi (dalolatnomada oʻzgarmaydi)."

#: texnazor/sheet.py:1153
msgid "Сводка сон билан ёзилган — далолатномада ишларга мутаносиб ({0} та жамлама)"
msgstr ""
"Svodka son bilan yozilgan — dalolatnomada ishlarga mutanosib ({0} ta jamlama)"

#: texnazor/sheet.py:1154
msgid ""
"Бўлим жамлари («ЗАТРАТЫ ТРУДА…», «ЕСП 15%», «ИТОГО С УЧЕТОМ КОЭФФ.» ва ҳ.к.) файлда формуласиз сон ({0}-қаторлар). Тизим уларни далолатномага ўзгармай қўшмайди: ҳар бир жамлама ўз бўлими ишларининг пулига мутаносиб ҳисобланади (ҳажм ёзилмаса — 0, бўлим тўлиқ бажарилса — файлдагидек). Иш ҳақи ва материал улуши бўлимда ҳар хил бўлса, бир неча сўм фарқ бўлиши мумкин."
msgstr ""
"Boʻlim jamlari («ZATRATI TRUDA…», «YESP 15%», «ITOGO S UCHETOM KOEFF.» va h.k.) faylda formulasiz son ({0}-qatorlar). Tizim ularni dalolatnomaga oʻzgarmay qoʻshmaydi: har bir jamlama oʻz boʻlimi ishlarining puliga mutanosib hisoblanadi (hajm yozilmasa — 0, boʻlim toʻliq bajarilsa — fayldagidek). Ish haqi va material ulushi boʻlimda har xil boʻlsa, bir necha soʻm farq boʻlishi mumkin."

#: texnazor/sheet.py:1187
msgid "{0}-иш «{1}»: ҳажмга боғлиқ бўлмаган {2:,.2f} сўм"
msgstr "{0}-ish «{1}»: hajmga bogʻliq boʻlmagan {2:,.2f} soʻm"

#: texnazor/sheet.py:1188
msgid ""
"Excel формуласида {0} та қатор суммаси ҳажмга боғланмаган (масалан, «нарх × меъёр», «нарх × жами» ўрнига). Тизим файлдагидек ҳисоблайди, шунинг учун бу пул ҳар бир далолатномада чиқади. Смета тузувчи билан аниқлаштиринг."
msgstr ""
"Excel formulasida {0} ta qator summasi hajmga bogʻlanmagan (masalan, «narx × meʼyor», «narx × jami» oʻrniga). Tizim fayldagidek hisoblaydi, shuning uchun bu pul har bir dalolatnomada chiqadi. Smeta tuzuvchi bilan aniqlashtiring."

#: texnazor/sheet.py:1227
msgid "Файлдаги жами {0}, тизим ҳисоби {1} (фарқ {2})"
msgstr "Fayldagi jami {0}, tizim hisobi {1} (farq {2})"

#: texnazor/sheet.py:1228
msgid ""
"Тизим ҳамма формулаларни қайта ҳисоблади. Фарқ одатда сводкада қўлда ёзилган ёки эскирган сондан бўлади — смета тузувчи билан текширинг. Далолатномалар тизим ҳисоби бўйича."
msgstr ""
"Tizim hamma formulalarni qayta hisobladi. Farq odatda svodkada qoʻlda yozilgan yoki eskirgan sondan boʻladi — smeta tuzuvchi bilan tekshiring. Dalolatnomalar tizim hisobi boʻyicha."

#: texnazor/sheet.py:1244
msgid "Офёрта жами 0 чиқди"
msgstr "Ofyorta jami 0 chiqdi"

#: texnazor/sheet.py:1245
msgid ""
"Тизим иш қаторлари ёки уларнинг суммасини топа олмади (устунлар бошқача жойлашган бўлиши мумкин). Далолатнома суммалари нотўғри бўлади."
msgstr ""
"Tizim ish qatorlari yoki ularning summasini topa olmadi (ustunlar boshqacha joylashgan boʻlishi mumkin). Dalolatnoma summalari notoʻgʻri boʻladi."

