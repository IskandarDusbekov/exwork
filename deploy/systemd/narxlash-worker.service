[Unit]
Description=Narxlash — fon ishchisi (papka ochish va narxlash)
After=network.target postgresql.service redis-server.service docker.service

[Service]
User=narxlash
Group=narxlash
WorkingDirectory=/srv/narxlash/app
EnvironmentFile=/srv/narxlash/.env
# LibreOffice o'z profilini shu yerga yozadi
Environment=HOME=/srv/narxlash
ExecStart=/srv/narxlash/venv/bin/python manage.py run_worker --threads 2
# Narxlash va LibreOffice CPU'ni to'liq egallasa ham sayt (gunicorn) sekinlashmasin: worker past ustuvorlikda
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# SIGTERM — yangi ish olinmaydi, boshlanganlari tugatiladi (5 daqiqagacha kutiladi)
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=always
RestartSec=5
UMask=0027
# Begona fayllar (LibreOffice, unrar) shu jarayon ichida ochiladi — zaiflik bo'lsa ham zarar cheklansin:
# huquq oshirib bo'lmaydi, /tmp alohida, tizim fayllari va /home, /root yozib/o'qib bo'lmaydi.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
