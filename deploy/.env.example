# Нархлаш — production муҳит ўзгарувчилари.
# Серверда: /srv/narxlash/.env (эгаси narxlash, ҳуқуқ 600). Сайт, worker ва manage.sh шу файлни ўқийди.
# <…> белгили жойларни ўзингизникига алмаштиринг.

# ---------- асосий ----------
DJANGO_DEBUG=0
# python3 -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=<узун-тасодифий-калит>
# Домен олингунча (SSH туннел орқали, README → «Домен олингунча»): localhost,127.0.0.1
# Домен фаоллашгач:                                                 narxlash.uz,www.narxlash.uz
DJANGO_ALLOWED_HOSTS=<narxlash.uz>
# Сайт олдидаги проксилар сони: фақат nginx — 1; Cloudflare + nginx — 2
NARXLASH_TRUST_PROXY=1

# ---------- махфий манзиллар ----------
# Django admin ва бошқарув панели — тахмин қилиб бўлмайдиган узун йўл (камида 16 белги, охирида /).
# Ҳар бири учун алоҳида:  python3 -c "import secrets; print('boshqaruv-' + secrets.token_hex(8) + '/')"
# Фақат лотин ҳарф, рақам, - ва _. Бу манзилларни ҳеч кимга берманг ва саҳифаларга ёзманг.
NARXLASH_ADMIN_URL=<sys-a91f3c07e2b45d18/>
NARXLASH_PANEL_URL=<boshqaruv-5c8e21d9f04a7b36/>

# ---------- база ва кеш ----------
# Серверда PostgreSQL ва Redis apt билан ўрнатилган бўлса (бошқа сайтлар билан умумий) — шулардан фойдаланилади:
#   sudo -u postgres psql -c "CREATE USER narxlash WITH PASSWORD '<postgres-пароли>';"
#   sudo -u postgres psql -c "CREATE DATABASE narxlash OWNER narxlash;"
DATABASE_URL=postgres://narxlash:<postgres-пароли>@127.0.0.1:5432/narxlash
# Redis: /5 — алоҳида рақамли база (бошқа сайтлар калитлари билан аралашмайди).
# Redis пароли бўлса: redis://:<redis-пароли>@127.0.0.1:6379/5
REDIS_URL=redis://127.0.0.1:6379/5
# Фақат deploy/docker-compose.yml ишлатилса (сервер бўш бўлса) — Docker шу паролларни олади:
# POSTGRES_PASSWORD=<postgres-пароли>
# REDIS_PASSWORD=<redis-пароли>

# ---------- фон иши ва жараёнлар ----------
NARXLASH_TASKS=worker
# 2 ядро / 4 GB RAM (бошқа сайтлар билан): 3 та. Кўрсатилмаса — 2×ядро+1 (5 тагача)
GUNICORN_WORKERS=3

# ---------- файллар ва жойлар ----------
NARXLASH_MEDIA_ROOT=/srv/narxlash/media
NARXLASH_STATIC_ROOT=/srv/narxlash/static
NARXLASH_LOG_DIR=/srv/narxlash/logs

# ---------- HTTPS ----------
# Домен олингунча (SSH туннел, http://localhost) — 0. Сертификат олингач — АЛБАТТА 1 (ёки қаторни ўчиринг).
DJANGO_SSL_REDIRECT=1

# ---------- email (паролни тиклаш) ----------
EMAIL_HOST=<smtp.gmail.com>
EMAIL_PORT=587
EMAIL_HOST_USER=<почта-логини>
EMAIL_HOST_PASSWORD=<почта-пароли-ёки-app-password>
# қўштирноқ шарт: файл bash'да ҳам ўқилади (manage.sh, backup.sh), < белгиси қўштирноқсиз хато беради
DEFAULT_FROM_EMAIL="Нархлаш <noreply@narxlash.uz>"

# ---------- ихтиёрий ----------
# NARXLASH_SOFFICE=/usr/bin/soffice
