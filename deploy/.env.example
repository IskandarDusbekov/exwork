# docker-compose учун (deploy/.env га нусха олинг ва паролларни алмаштиринг)
POSTGRES_PASSWORD=bu-yerga-uzun-tasodifiy-parol
REDIS_PASSWORD=bu-yerga-boshqa-uzun-parol

# Сайт ва worker учун муҳит ўзгарувчилари (иккаласида бир хил бўлсин):
# DATABASE_URL=postgres://narxlash:<POSTGRES_PASSWORD>@127.0.0.1:5432/narxlash
# REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0
# NARXLASH_TASKS=worker
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(60))">
# DJANGO_ALLOWED_HOSTS=narxlash.uz
# Сайт олдидаги проксилар сони: фақат nginx — 1; Cloudflare + nginx — 2 (0 қолса ҳамма бир IP бўлиб кўринади)
# NARXLASH_TRUST_PROXY=1
